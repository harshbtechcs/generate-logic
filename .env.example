# Copy this file to .env.local and fill in the values.
# Never commit real values or share them. In production they come from AWS Secrets Manager.
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Public site URL (no trailing slash). Live: https://generatelogic.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- YouTube auto-sync -------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials (YouTube Data API v3)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCIoqo_YSSWqZ5Yw0PbUpU2w
# Secret for POST /api/youtube/refresh (force sync now)
REVALIDATE_SECRET=

# --- Database (Neon PostgreSQL) ----------------------------------------------
# Neon dashboard -> Connect. Pooled link (host contains "-pooler") for the app,
# direct link (pooling off) for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Authentication -----------------------------------------------------------
# Signs and encrypts login sessions. Use a different value in production.
AUTH_SECRET=
# Google Cloud Console -> Google Auth Platform -> Clients (Web application)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# This email becomes Admin once it is verified (Google sign-in or email link)
ADMIN_EMAIL=

# --- Email (Resend) ----------------------------------------------------------
# resend.com -> API Keys (Sending access). Until generatelogic.in is verified in
# Resend, emails can only be sent to the address you signed up to Resend with.
RESEND_API_KEY=
EMAIL_FROM="Generate Logic <onboarding@resend.dev>"

# --- AWS (Phase 5: notes storage) -------------------------------------------
# AWS_REGION=ap-south-1
# S3_NOTES_BUCKET=
